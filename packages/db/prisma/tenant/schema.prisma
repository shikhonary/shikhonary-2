generator client {
  provider = "prisma-client"
  output   = "../../generated/tenant"
}

datasource db {
  provider = "postgresql"
}

model FiscalYear {
  id        String   @id @default(cuid())
  year      String // e.g. "2026"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  tenantId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([isCurrent])
  @@map("fiscal_year")
}

model Counter {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("counter")
}



