{
  "name": "@workspace/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "generate": "prisma generate --config prisma/main/prisma.config.ts && prisma generate --config prisma/tenant/prisma.config.ts",
    "migrate:main": "prisma migrate dev --config prisma/main/prisma.config.ts",
    "migrate:tenant": "prisma migrate dev --config prisma/tenant/prisma.config.ts",
    "migrate:deploy:main": "prisma migrate deploy --config prisma/main/prisma.config.ts",
    "migrate:deploy": "prisma migrate deploy --config prisma/main/prisma.config.ts && prisma migrate deploy --config prisma/tenant/prisma.config.ts",
    "studio:main": "prisma studio --config prisma/main/prisma.config.ts",
    "studio:tenant": "prisma studio --config prisma/tenant/prisma.config.ts",
    "seed:main": "node --loader ts-node/esm prisma/seed/main.seed.ts",
    "seed:tenant": "node --loader ts-node/esm prisma/seed/tenant.seed.ts",
    "sync:main": "npx -y tsx prisma/seed/sync-main-migrations.ts",
    "fetch:question-types": "npx -y tsx prisma/seed/fetch-question-types.ts",

    "assign-super-admin": "npx -y tsx prisma/seed/assign-super-admin.ts",
    "seed:subscriptions": "npx -y tsx prisma/seed/seed-subscriptions.ts",
    "seed:bd-geo": "npx -y tsx prisma/seed/seed-bd-geo.ts",
    "tenants:migrate": "npx -y tsx prisma/seed/migrate-tenants.ts",
    "reset:main": "prisma migrate reset --force --config prisma/main/prisma.config.ts",
    "reset:tenant": "prisma migrate reset --force --config prisma/tenant/prisma.config.ts",
    "reset": "npx -y tsx prisma/seed/reset.ts",
    "clean:databases": "npx -y tsx prisma/seed/clean-tenant-databases.ts",
    "clean:databases:except-mandori": "npx -y tsx prisma/seed/clean-except-mandori.ts",
    "clean:branches": "npx -y tsx scripts/delete-branches.ts",
    "clean:mcq-references": "npx -y tsx scripts/clean-mcq-references.ts",
    "clean:word-meaning-references": "npx -y tsx scripts/clean-word-meaning-references.ts",
    "update:poem-board-book-source": "npx -y tsx scripts/update-poem-board-book-source.ts",
    "update:question-source-session": "npx -y tsx scripts/update-question-source-session.ts",
    "update:today-word-meaning-source": "npx -y tsx scripts/update-today-word-meaning-source.ts",
    "seed:class3-dan-bam-milkoron": "npx -y tsx scripts/seed-class3-dan-bam-milkoron.ts",
    "seed:class3-punctuation": "npx -y tsx scripts/seed-class3-punctuation.ts",
    "seed:class3-opposite-words": "npx -y tsx scripts/seed-class3-opposite-words.ts",
    "seed:class3-synonyms": "npx -y tsx scripts/seed-class3-synonyms.ts",
    "seed:class3-ek-kothay-prokash": "npx -y tsx scripts/seed-class3-ek-kothay-prokash.ts",
    "seed:class3-paragraph": "npx -y tsx scripts/seed-class3-paragraph.ts",
    "seed:class3-essay": "npx -y tsx scripts/seed-class3-essay.ts",
    "seed:class3-form-fillup": "npx -y tsx scripts/seed-class3-form-fillup.ts",
    "seed:class3-grammar": "npx -y tsx scripts/seed-class3-grammar.ts",
    "seed:class3-fill-in-the-blanks-with-clues": "npx -y tsx scripts/seed-class3-fill-in-the-blanks-with-clues.ts",
    "seed:class3-fill-in-the-blanks-without-clues": "npx -y tsx scripts/seed-class3-fill-in-the-blanks-without-clues.ts",
    "seed:class3-shuddho-ashuddho": "npx -y tsx scripts/seed-class3-shuddho-ashuddho.ts",
    "seed:class3-short-questions": "npx -y tsx scripts/seed-class3-short-questions.ts",
    "seed:class3-descriptive-questions": "npx -y tsx scripts/seed-class3-descriptive-questions.ts",
    "seed:class3-bgs-dan-bam-milkoron": "npx -y tsx scripts/seed-class3-bgs-dan-bam-milkoron.ts",
    "seed:class3-science-fill-in-the-blanks-without-clues": "npx -y tsx scripts/seed-class3-science-fill-in-the-blanks-without-clues.ts",
    "seed:class3-science-shuddho-ashuddho": "npx -y tsx scripts/seed-class3-science-shuddho-ashuddho.ts",
    "seed:class3-science-short-questions": "npx -y tsx scripts/seed-class3-science-short-questions.ts",
    "seed:class3-science-descriptive-questions": "npx -y tsx scripts/seed-class3-science-descriptive-questions.ts",
    "seed:class3-science-dan-bam-milkoron": "npx -y tsx scripts/seed-class3-science-dan-bam-milkoron.ts",
    "seed:class3-islamic-fill-in-the-blanks-without-clues": "npx -y tsx scripts/seed-class3-islamic-fill-in-the-blanks-without-clues.ts",
    "seed:class3-islamic-shuddho-ashuddho": "npx -y tsx scripts/seed-class3-islamic-shuddho-ashuddho.ts",
    "seed:class3-islamic-short-questions": "npx -y tsx scripts/seed-class3-islamic-short-questions.ts",
    "seed:class3-islamic-descriptive-questions": "npx -y tsx scripts/seed-class3-islamic-descriptive-questions.ts",
    "seed:class3-islamic-dan-bam-milkoron": "npx -y tsx scripts/seed-class3-islamic-dan-bam-milkoron.ts",
    "seed:number-in-words": "tsx scripts/seed-number-in-words.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.15.2",
    "@workspace/typescript-config": "workspace:*",
    "dotenv": "^16.5.0",
    "prisma": "^7.0.0",
    "tsx": "^4.23.11",
    "typescript": "^5"
  },
  "exports": {
    ".": "./src/index.ts",
    "./main": "./src/main.ts",
    "./tenant": "./src/tenant.ts"
  }
}
