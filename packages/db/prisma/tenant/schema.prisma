generator client {
  provider = "prisma-client"
  output   = "../../generated/tenant"
}

datasource db {
  provider = "postgresql"
}

model FiscalYear {
  id        String   @id @default(cuid())
  year      String   // e.g. "2026"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  tenantId  String?

  taxPayments TaxPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([isCurrent])
  @@map("fiscal_year")
}

model Ward {
  id     String @id @default(cuid())
  name   String
  nameBn String

  taxPayers    TaxPayer[]
  citizens     CitizenAddress[]
  applications CitizenApplicationAddress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ward")
}

model TaxPayer {
  id         String  @id @default(cuid())
  holding    String
  name       String
  fatherName String?
  phone      String?
  nid        String?
  wardId     String
  ward       Ward    @relation(fields: [wardId], references: [id])
  village    String
  tax        Int     @default(0)

  payments TaxPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wardId])
  @@index([nid])
  @@index([phone])
  @@index([holding])
  @@map("tax_payer")
}

model TaxPayment {
  id            String     @id @default(cuid())
  taxPayerId    String
  taxPayer      TaxPayer   @relation(fields: [taxPayerId], references: [id], onDelete: Cascade)
  fiscalYearId  String
  fiscalYear    FiscalYear @relation(fields: [fiscalYearId], references: [id])
  amount        Int
  receiptNo     String?
  paymentDate   DateTime   @default(now())
  paymentMethod String?
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taxPayerId])
  @@index([fiscalYearId])
  @@map("tax_payment")
}

model CitizenAddress {
  id                      String    @id @default(cuid())
  villageEn               String?   // গ্রাম/মহল্লা (ইংরেজিতে)
  villageBn               String    // গ্রাম/মহল্লা (বাংলায়)
  roadEn                  String?   // রোড/ব্লক/সেক্টর (ইংরেজিতে)
  roadBn                  String?   // রোড/ব্লক/সেক্টর (বাংলায়)
  holdingNo               String?   // হোল্ডিং নং

  // Local Ward DB relation (Required)
  wardId                  String
  ward                    Ward      @relation(fields: [wardId], references: [id])

  // Flat Geo-location details (Required IDs and Bangla names, Optional English names)
  divisionId              String
  divisionNameBn          String
  divisionNameEn          String?

  districtId              String
  districtNameBn          String
  districtNameEn          String?

  upazilaId               String
  upazilaNameBn           String
  upazilaNameEn           String?

  unionId                 String
  unionNameBn             String
  unionNameEn             String?

  postId                  String
  postOfficeBn            String
  postOfficeEn            String?
  postCode                String

  // Back relations to Citizen
  presentCitizen          Citizen?  @relation("PresentAddress")
  permanentCitizen        Citizen?  @relation("PermanentAddress")

  createdAt               DateTime  @default(now())

  @@index([wardId])
  @@map("citizen_address")
}

model Citizen {
  id                  String         @id @default(cuid())
  status              String         @default("PENDING") // PENDING, APPROVED, REJECTED (defined in utils)

  // ── Identity / Search Section (Unique) ────────────────────
  nid                 String?        @unique // ন্যাশনাল আইডি
  birthRegNo          String?        @unique // জন্ম নিবন্ধন নং
  passportNo          String?        @unique // পাসপোর্ট নং

  // ── Personal Information ──────────────────────────────────
  nameEn              String?        // নাম (ইংরেজিতে)
  nameBn              String         // নাম (বাংলায়)
  dob                 DateTime?      // জন্ম তারিখ
  fatherNameEn        String?        // পিতার নাম (ইংরেজিতে)
  fatherNameBn        String         // পিতার নাম (বাংলায়)
  motherNameEn        String?        // মাতার নাম (ইংরেজিতে)
  motherNameBn        String         // মাতার নাম (বাংলায়)
  occupation          String?        // পেশা
  residentType        String         // বাসিন্দা (TEMPORARY, PERMANENT)
  education           String?        // শিক্ষাগত যোগ্যতা
  religion            String         // ধর্ম
  gender              String         // লিঙ্গ
  maritalStatus       String         // বৈবাহিক সম্পর্ক

  // ── Addresses (@unique enforces 1:1 ownership) ────────────
  presentAddressId    String         @unique
  presentAddress      CitizenAddress @relation("PresentAddress", fields: [presentAddressId], references: [id], onDelete: Cascade)

  sameAsPresent       Boolean        @default(false) // ঠিকানা একই হলে টিক দিন
  permanentAddressId  String?        @unique
  permanentAddress    CitizenAddress? @relation("PermanentAddress", fields: [permanentAddressId], references: [id], onDelete: Cascade)

  // ── Contact Information ───────────────────────────────────
  mobile              String         // মোবাইল
  email               String?        // ইমেল
  commentsEn          String?        // মন্তব্য দিন (ইংরেজিতে)
  commentsBn          String?        // মন্তব্য দিন (বাংলায়)

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([mobile])
  @@map("citizen")
}

model CitizenApplicationAddress {
  id                      String               @id @default(cuid())
  villageEn               String?
  villageBn               String
  roadEn                  String?
  roadBn                  String?
  holdingNo               String?

  // Local Ward DB relation
  wardId                  String
  ward                    Ward                 @relation(fields: [wardId], references: [id])

  // Flat Geo-location details
  divisionId              String
  divisionNameBn          String
  divisionNameEn          String?

  districtId              String
  districtNameBn          String
  districtNameEn          String?

  upazilaId               String
  upazilaNameBn           String
  upazilaNameEn           String?

  unionId                 String
  unionNameBn             String
  unionNameEn             String?

  postId                  String
  postOfficeBn            String
  postOfficeEn            String?
  postCode                String

  // Back relations to CitizenApplication
  presentApplication      CitizenApplication?  @relation("PresentAddress")
  permanentApplication    CitizenApplication?  @relation("PermanentAddress")

  createdAt               DateTime             @default(now())

  @@index([wardId])
  @@map("citizen_application_address")
}

model CitizenApplication {
  id                  String                     @id @default(cuid())
  status              String                     @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason     String?

  // ── Identity (Non-unique — allows re-application after rejection) ──
  nid                 String?
  birthRegNo          String?
  passportNo          String?

  // ── Personal Information ──────────────────────────────────
  nameEn              String?
  nameBn              String
  dob                 DateTime?
  fatherNameEn        String?
  fatherNameBn        String
  motherNameEn        String?
  motherNameBn        String
  occupation          String?
  residentType        String
  education           String?
  religion            String
  gender              String
  maritalStatus       String

  // ── Addresses (@unique enforces 1:1 ownership) ────────────
  presentAddressId    String                     @unique
  presentAddress      CitizenApplicationAddress  @relation("PresentAddress", fields: [presentAddressId], references: [id], onDelete: Cascade)

  sameAsPresent       Boolean                    @default(false)
  permanentAddressId  String?                    @unique
  permanentAddress    CitizenApplicationAddress? @relation("PermanentAddress", fields: [permanentAddressId], references: [id], onDelete: Cascade)

  // ── Contact Information ───────────────────────────────────
  mobile              String
  email               String?
  commentsEn          String?
  commentsBn          String?

  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([nid])
  @@index([birthRegNo])
  @@index([passportNo])
  @@index([mobile])
  @@index([status, createdAt])
  @@map("citizen_application")
}



