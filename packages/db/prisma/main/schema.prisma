generator client {
  provider = "prisma-client"
  output   = "../../generated/main"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String?   @unique
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  emailVerified       Boolean        @default(false)
  image               String?
  phoneNumber         String?        @unique
  phoneNumberVerified Boolean        @default(false)
  sessions            Session[]
  accounts            Account[]
  roles               Role[]
  memberships         TenantMember[]
  tenants             Tenant[]       @relation("TenantOwner")

  // ── Authoring Relations ──
  createdMcqs              Mcq[]              @relation("McqCreator")
  updatedMcqs              Mcq[]              @relation("McqUpdater")
  createdCqs               Cq[]               @relation("CqCreator")
  updatedCqs               Cq[]               @relation("CqUpdater")
  createdPbqs              PBQ[]              @relation("PbqCreator")
  updatedPbqs              PBQ[]              @relation("PbqUpdater")
  createdShortAnswers      ShortAnswer[]      @relation("ShortAnswerCreator")
  updatedShortAnswers      ShortAnswer[]      @relation("ShortAnswerUpdater")
  createdParagraphs        Paragraph[]        @relation("ParagraphCreator")
  updatedParagraphs        Paragraph[]        @relation("ParagraphUpdater")
  createdAmplifications    Amplification[]    @relation("AmplificationCreator")
  updatedAmplifications    Amplification[]    @relation("AmplificationUpdater")
  createdCs                CS[]               @relation("CsCreator")
  updatedCs                CS[]               @relation("CsUpdater")
  createdLetters           Letter[]           @relation("LetterCreator")
  updatedLetters           Letter[]           @relation("LetterUpdater")
  createdApplications      Application[]      @relation("ApplicationCreator")
  updatedApplications      Application[]      @relation("ApplicationUpdater")
  createdSummaries         Summary[]          @relation("SummaryCreator")
  updatedSummaries         Summary[]          @relation("SummaryUpdater")
  createdEssences          Essence[]          @relation("EssenceCreator")
  updatedEssences          Essence[]          @relation("EssenceUpdater")
  createdThoughtExpansions ThoughtExpansion[] @relation("ThoughtExpansionCreator")
  updatedThoughtExpansions ThoughtExpansion[] @relation("ThoughtExpansionUpdater")
  createdNewsReports       NewsReport[]       @relation("NewsReportCreator")
  updatedNewsReports       NewsReport[]       @relation("NewsReportUpdater")
  createdEssays            Essay[]            @relation("EssayCreator")
  updatedEssays            Essay[]            @relation("EssayUpdater")
  createdPartsOfSpeech            PartsOfSpeech[]            @relation("PartsOfSpeechCreator")
  updatedPartsOfSpeech            PartsOfSpeech[]            @relation("PartsOfSpeechUpdater")
  createdFillInTheBlanksWithClues FillInTheBlanksWithClues[] @relation("FillInTheBlanksWithCluesCreator")
  updatedFillInTheBlanksWithClues FillInTheBlanksWithClues[] @relation("FillInTheBlanksWithCluesUpdater")

  // ── Moderation / Reports ──
  reportedQuestions QuestionReport[] @relation("ReportedQuestions")
  resolvedReports   QuestionReport[] @relation("ResolvedReports")

  @@index([deletedAt])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("role")
}

model Tenant {
  id          String  @id @default(cuid())
  name        String
  nameBn      String?
  slug        String  @unique
  description String?
  logo        String?
  type        String  @default("SCHOOL")
  email       String?
  phone       String?

  // ── Educational Institution Details ──────────────────────
  eiin            String?
  board           String?
  address         String?
  establishedYear Int? // Year the institution was founded
  curriculum      String? // NATIONAL | ENGLISH_MEDIUM | MADRASA | CAMBRIDGE | IB | EDEXCEL
  medium          String? // BANGLA | ENGLISH | BOTH
  shift           String? // MORNING | DAY | BOTH

  // ── Bangladesh Geographical Hierarchy ────────────────────
  divisionId String?
  division   Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  districtId String?
  district   District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  upazilaId  String?
  upazila    Upazila?  @relation(fields: [upazilaId], references: [id], onDelete: SetNull)
  unionId    String?
  union      Union?    @relation(fields: [unionId], references: [id], onDelete: SetNull)
  postalCode String?

  // ── Institution Officials ─────────────────────────────────
  principalName          String?
  principalSignature     String?
  vicePrincipalName      String?
  vicePrincipalSignature String?

  // ── Social & Branding ────────────────────────────────────
  website     String?
  socialLinks Json    @default("{}")

  // ── Domain & Branding ────────────────────────────────────
  subdomain            String? @unique
  customDomain         String? @unique
  customDomainVerified Boolean @default(false)

  // ── Database Provisioning ────────────────────────────────
  databaseName     String? @unique
  connectionString String?
  databaseStatus   String  @default("PENDING")

  // ── Usage Counters ───────────────────────────────────────
  studentCount  Int @default(0)
  teacherCount  Int @default(0)
  examCount     Int @default(0)
  storageUsedMB Int @default(0)

  // ── Status & Lifecycle ───────────────────────────────────
  isActive      Boolean @default(true)
  isSuspended   Boolean @default(false)
  suspendReason String?
  metadata      Json    @default("{}")

  // ── Fiscal Year Pointer ──────────────────────────────────
  currentFiscalYearId String?
  currentFiscalYear   FiscalYear? @relation("CurrentFiscalYear", fields: [currentFiscalYearId], references: [id], onDelete: SetNull)

  // ── Owner ────────────────────────────────────────────────
  createdById String?
  owner       User?   @relation("TenantOwner", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // ── Custom Overrides ─────────────────────────────────────
  customStudentLimit Int?
  customTeacherLimit Int?
  customExamLimit    Int?
  customStorageLimit Int?

  // ── Credit System ──────────────────────────────────────────
  creditBalance    Int @default(0)
  totalCreditsUsed Int @default(0)

  // ── Relations ────────────────────────────────────────────
  subscription       Subscription?
  members            TenantMember[]
  invitations        TenantInvitation[]
  creditTransactions CreditTransaction[]
  fiscalYears        FiscalYear[]
  invoices           Invoice[]

  // ── Question Bank Resources ──────────────────────────────
  mcqs              Mcq[]
  cqs               Cq[]
  shortAnswers      ShortAnswer[]
  paragraphs        Paragraph[]
  amplifications    Amplification[]
  cs                CS[]
  letters           Letter[]
  applications      Application[]
  summaries         Summary[]
  essences          Essence[]
  thoughtExpansions ThoughtExpansion[]
  newsReports       NewsReport[]
  essays            Essay[]
  pbqs              PBQ[]
  partsOfSpeech            PartsOfSpeech[]
  fillInTheBlanksWithClues FillInTheBlanksWithClues[]

  @@index([isActive])
  @@index([deletedAt, isActive])
  @@index([createdById])
  @@index([currentFiscalYearId])
  @@index([divisionId])
  @@index([districtId])
  @@index([upazilaId])
  @@index([unionId])
  @@map("tenant")
}

model TenantMember {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("MEMBER")
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("tenant_member")
}

model TenantInvitation {
  id         String    @id @default(cuid())
  tenantId   String
  email      String
  role       String    @default("STAFF")
  token      String    @unique
  expiresAt  DateTime
  invitedBy  String
  acceptedAt DateTime?
  acceptedBy String?
  message    String?
  name       String?
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([email, tenantId])
  @@index([status])
  @@index([tenantId])
  @@map("tenant_invitation")
}

model SubscriptionPlan {
  id          String  @id @default(cuid())
  name        String  @unique
  displayName String
  description String?

  monthlyPriceBDT Int @default(0)
  yearlyPriceBDT  Int @default(0)

  features  Json    @default("{}")
  isActive  Boolean @default(true)
  isPopular Boolean @default(false)

  // ── Resource Limits ──────────────────────────────────────
  defaultStudentLimit Int @default(1000)
  defaultTeacherLimit Int @default(10)
  defaultExamLimit    Int @default(500)
  defaultStorageLimit Int @default(500)
  defaultCreditLimit  Int @default(30)

  // ── Feature Flags ────────────────────────────────────────
  canCreateExams      Boolean @default(true)
  canCollectFees      Boolean @default(false)
  canUseLms           Boolean @default(false)
  canManageAttendance Boolean @default(false)
  canManageLibrary    Boolean @default(false)
  canManageTransport  Boolean @default(false)
  canSendSms          Boolean @default(false)
  canUseCustomDomain  Boolean @default(false)
  canUseAiFeatures    Boolean @default(false)
  canExportReports    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plan")
}

model Subscription {
  id       String @id @default(cuid())
  tenantId String @unique
  planId   String

  status String @default("ACTIVE")

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?

  billingCycle  String @default("YEARLY")
  currency      String @default("BDT")
  pricePerMonth Int    @default(0)
  pricePerYear  Int?

  paymentProvider String?
  externalId      String?

  cancelAtPeriodEnd Boolean   @default(false)
  canceledAt        DateTime?
  cancelReason      String?

  customStudentLimit Int?
  customTeacherLimit Int?
  customExamLimit    Int?
  customStorageLimit Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  history SubscriptionHistory[]

  @@index([currentPeriodEnd])
  @@index([planId])
  @@index([status])
  @@map("subscription")
}

model CreditTransaction {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  type    String // SUBSCRIPTION_REFRESH | PURCHASE | USAGE | REFUND | ADMIN_ADJUSTMENT
  amount  Int // positive for credits in, negative for credits out
  balance Int // Running balance after this transaction

  description String

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([type])
  @@index([createdAt])
  @@map("credit_transaction")
}

model SubscriptionHistory {
  id             String   @id @default(cuid())
  subscriptionId String
  event          String
  fromPlanId     String?
  toPlanId       String?
  fromStatus     String?
  toStatus       String?
  reason         String?
  metadata       Json     @default("{}")
  createdBy      String?
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([subscriptionId])
  @@index([subscriptionId, createdAt])
  @@map("subscription_history")
}

model Invoice {
  id            String @id @default(cuid())
  tenantId      String
  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoiceNumber String @unique
  amount        Int
  currency      String @default("BDT")
  status        String @default("PENDING")

  periodStart DateTime
  periodEnd   DateTime
  dueDate     DateTime?
  paidAt      DateTime?

  paymentMethod    String?
  paymentProvider  String?
  paymentReference String?

  pdfUrl      String? @map("invoicePdfUrl")
  lineItems   Json    @default("[]")
  description String?
  notes       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([dueDate])
  @@index([status])
  @@index([tenantId])
  @@index([deletedAt])
  @@map("invoice")
}

model FiscalYear {
  id        String   @id @default(cuid())
  year      String // e.g. "2026"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  currentForTenants Tenant[] @relation("CurrentFiscalYear")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, year])
  @@index([tenantId])
  @@index([isCurrent])
  @@map("fiscal_year")
}

model Division {
  id        String     @id
  name      String     @unique
  nameBn    String
  url       String?
  districts District[]
  tenants   Tenant[]

  @@map("division")
}

model District {
  id         String    @id
  name       String    @unique
  nameBn     String
  url        String?
  divisionId String
  division   Division  @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  upazilas   Upazila[]
  tenants    Tenant[]

  @@index([divisionId])
  @@map("district")
}

model Upazila {
  id         String   @id
  name       String
  nameBn     String
  url        String?
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Restrict)
  unions     Union[]
  posts      Post[]
  tenants    Tenant[]

  @@index([districtId])
  @@map("upazila")
}

model Union {
  id        String   @id
  name      String
  nameBn    String
  url       String?
  upazilaId String
  upazila   Upazila  @relation(fields: [upazilaId], references: [id], onDelete: Restrict)
  tenants   Tenant[]

  @@index([upazilaId])
  @@map("union")
}

model Post {
  id           String  @id @default(cuid())
  postOffice   String
  postOfficeBn String?
  postCode     String
  upazilaId    String
  upazila      Upazila @relation(fields: [upazilaId], references: [id], onDelete: Restrict)

  @@index([upazilaId])
  @@index([postCode])
  @@map("post")
}

model AcademicYear {
  id        String   @id @default(cuid())
  nameBn    String
  nameEn    String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects AcademicSubject[]
  chapters AcademicChapter[]

  @@index([isCurrent])
  @@index([isActive])
  @@map("academic_year")
}

model AcademicClass {
  id       String  @id @default(cuid())
  nameBn   String
  nameEn   String
  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classSubjects AcademicClassSubject[]

  @@index([isActive])
  @@index([nameEn])
  @@map("academic_class")
}

model AcademicSubject {
  id       String  @id @default(cuid())
  nameBn   String
  nameEn   String
  code     String?
  group    String?
  isActive Boolean @default(true)

  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classSubjects        AcademicClassSubject[]
  chapters             AcademicChapter[]
  subjectQuestionTypes SubjectQuestionType[]
  sections             SubjectQuestionSection[]
  mcqs                 Mcq[]
  cqs                  Cq[]
  shortAnswers         ShortAnswer[]
  paragraphs           Paragraph[]
  amplifications       Amplification[]
  cs                   CS[]
  letters              Letter[]
  applications         Application[]
  summaries            Summary[]
  essences             Essence[]
  thoughtExpansions    ThoughtExpansion[]
  newsReports          NewsReport[]
  essays               Essay[]
  pbqs                     PBQ[]
  partsOfSpeech            PartsOfSpeech[]
  fillInTheBlanksWithClues FillInTheBlanksWithClues[]

  @@index([isActive])
  @@index([academicYearId])
  @@index([code])
  @@map("academic_subject")
}

model AcademicClassSubject {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  academicClass   AcademicClass   @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicSubject AcademicSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([subjectId])
  @@map("academic_class_subject")
}

model AcademicChapter {
  id       String  @id @default(cuid())
  nameBn   String
  nameEn   String
  position Int     @default(0)
  isActive Boolean @default(true)

  subjectId String
  subject   AcademicSubject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mcqs           Mcq[]
  cqs            Cq[]
  pbqs           PBQ[]
  shortAnswers   ShortAnswer[]
  paragraphs     Paragraph[]
  amplifications Amplification[]
  cs                       CS[]
  partsOfSpeech            PartsOfSpeech[]
  fillInTheBlanksWithClues FillInTheBlanksWithClues[]

  @@unique([subjectId, position])
  @@index([isActive])
  @@index([subjectId])
  @@index([academicYearId])
  @@map("academic_chapter")
}

// ═══════════════════════════════════════════════════════════════
// ██  Question Bank Models
// ═══════════════════════════════════════════════════════════════

model QuestionType {
  id            String  @id @default(cuid())
  nameEn        String  @unique
  nameBn        String
  label         String?
  mark          Float
  position      Int     @default(0)
  descriptionEn String?
  descriptionBn String?
  isActive      Boolean @default(true)

  // ── Relations ──
  subjects     SubjectQuestionType[]
  mcqs         Mcq[]
  cqs          Cq[]
  shortAnswers ShortAnswer[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  paragraphs        Paragraph[]
  amplifications    Amplification[]
  cs                CS[]
  letters           Letter[]
  applications      Application[]
  summaries         Summary[]
  essences          Essence[]
  thoughtExpansions ThoughtExpansion[]
  newsReports       NewsReport[]
  essays            Essay[]
  pbqs                     PBQ[]
  partsOfSpeech            PartsOfSpeech[]
  fillInTheBlanksWithClues FillInTheBlanksWithClues[]

  @@index([label])
  @@index([isActive])
  @@map("question_type")
}

model SubjectQuestionType {
  id             String  @id @default(cuid())
  subjectId      String
  questionTypeId String
  sectionId      String?
  subSectionId   String?

  customLabel      String?
  mark             Float
  markDistribution Json?
  totalQuestions   Int     @default(0)
  requiredCount    Int     @default(0)

  subject      AcademicSubject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questionType QuestionType               @relation(fields: [questionTypeId], references: [id], onDelete: Cascade)
  section      SubjectQuestionSection?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subSection   SubjectQuestionSubSection? @relation(fields: [subSectionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([subjectId])
  @@index([questionTypeId])
  @@index([sectionId])
  @@index([subSectionId])
  @@map("subject_question_type")
}

model SubjectQuestionSection {
  id           String  @id @default(cuid())
  nameBn       String
  nameEn       String
  position     Int     @default(0)
  subjectId    String
  instructions String?

  subject              AcademicSubject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectQuestionTypes SubjectQuestionType[]
  subSections          SubjectQuestionSubSection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
  @@map("subject_question_section")
}

model SubjectQuestionSubSection {
  id           String  @id @default(cuid())
  nameBn       String
  nameEn       String
  position     Int     @default(0)
  sectionId    String
  instructions String?

  section              SubjectQuestionSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectQuestionTypes SubjectQuestionType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
  @@map("subject_question_sub_section")
}

model Mcq {
  id          String   @id @default(cuid())
  question    String
  answer      String
  options     String[]
  statements  String[] @default([])
  type        String
  isMath      Boolean  @default(false)
  reference   String[] @default([])
  explanation String?
  questionUrl String?

  // ── Enrichment Fields ──
  difficulty      String @default("MEDIUM")
  popularityCount Int    @default(0)

  // ── Academic Hierarchy (required, Restrict delete) ──
  subjectId String
  chapterId String
  subject   AcademicSubject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  chapter   AcademicChapter @relation(fields: [chapterId], references: [id], onDelete: Restrict)

  // ── Question Type (optional, SetNull on delete) ──
  questionTypeId String?
  questionType   QuestionType? @relation(fields: [questionTypeId], references: [id], onDelete: SetNull)

  // ── Creator & Multi-Tenancy Tracking ──────────────────────
  createdById String?
  creator     User?   @relation("McqCreator", fields: [createdById], references: [id], onDelete: SetNull)

  updatedById String?
  updater     User?   @relation("McqUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  isGlobal Boolean @default(true)
  // ──────────────────────────────────────────────────────────

  isActive Boolean @default(true)

  // ── Child Relations ──
  attachments QuestionAttachment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([createdById])
  @@index([tenantId, isGlobal])
  @@index([questionTypeId])
  @@index([deletedAt])
  @@index([chapterId, type])
  @@index([isMath])
  @@index([subjectId, chapterId])
  @@index([subjectId, type])
  @@index([type])
  @@index([difficulty])
  @@map("mcq")
}

model Cq {
  id        String   @id @default(cuid())
  questionA String
  questionB String
  questionC String
  questionD String?
  context   String?
  reference String[] @default([])

  // ── Enrichment Fields ──
  difficulty      String @default("MEDIUM")
  marks           Json?
  popularityCount Int    @default(0)

  // ── Academic Hierarchy ──
  subjectId String
  chapterId String
  subject   AcademicSubject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  chapter   AcademicChapter @relation(fields: [chapterId], references: [id], onDelete: Restrict)

  // ── Question Type (optional) ──
  questionTypeId String?
  questionType   QuestionType? @relation(fields: [questionTypeId], references: [id], onDelete: SetNull)

  // ── Creator & Multi-Tenancy Tracking ──────────────────────
  createdById String?
  creator     User?   @relation("CqCreator", fields: [createdById], references: [id], onDelete: SetNull)

